# Konfigurasi TikTok Clipper
# Salin file ini menjadi .env dan isi GROQ_API_KEY Anda

GROQ_API_KEY=
# GROQ_BASE_URL hanya diisi jika Anda menggunakan reverse proxy khusus (biarkan kosong untuk Groq resmi)
GROQ_BASE_URL=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_DIR=output
CACHE_DIR=cache
LOG_DIR=logs
DEFAULT_MIN_DURATION=15
DEFAULT_MAX_DURATION=60
DEFAULT_NUM_CLIPS=3
DEFAULT_NICHE=umum
