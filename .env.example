# Konfigurasi TikTok Clipper v2.0 (Meta AI Muse Spark & Groq Whisper)
# Salin file ini menjadi .env

# 1. API Key Transkripsi Audio Whisper (Groq)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# 2. Konfigurasi Analisis LLM (Meta AI / Muse Spark)
LLM_PROVIDER=meta
# Masukkan MODEL_API_KEY Anda dari Meta AI
MODEL_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
# Model: muse-spark-1.2-contributor (atau muse-spark-1.2, muse-spark-1.1)
LLM_MODEL=muse-spark-1.2-contributor

# 3. Path & Direktori Sistem
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_DIR=output
CACHE_DIR=cache
LOG_DIR=logs

# 4. Pengaturan Default Video
DEFAULT_MIN_DURATION=15
DEFAULT_MAX_DURATION=60
DEFAULT_NUM_CLIPS=3
DEFAULT_NICHE=auto
