# Konfigurasi TikTok Clipper v2.0 (OpenAI Compatible & Groq Whisper)
# Salin file ini menjadi .env

# 1. API Key Transkripsi Audio Whisper (Groq)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# 2. Konfigurasi Analisis LLM (Pilih provider: groq | openai | deepseek | openrouter | custom)
LLM_PROVIDER=auto
LLM_API_KEY=
# LLM_BASE_URL (Opsional: https://api.openai.com/v1 | https://api.deepseek.com | https://openrouter.ai/api/v1)
LLM_BASE_URL=
# Model LLM (Groq: llama-3.3-70b-versatile | OpenAI: gpt-4o-mini | DeepSeek: deepseek-chat | OpenRouter: google/gemini-2.5-flash)
LLM_MODEL=llama-3.3-70b-versatile

# 3. Path & Direktori Sistem
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_DIR=output
CACHE_DIR=cache
LOG_DIR=logs

# 4. Pengaturan Default Video
DEFAULT_MIN_DURATION=15
DEFAULT_MAX_DURATION=60
DEFAULT_NUM_CLIPS=3
DEFAULT_NICHE=auto
